# Copia este ficheiro para ".env.local" e preenche com os dados do teu projeto Supabase.
# Sem estes valores a app corre em modo demonstração (dados só no aparelho).
#
# Onde encontrar: Supabase → Project Settings → API Keys
#   VITE_SUPABASE_URL      = Project URL (Project Settings → Data API)
#   VITE_SUPABASE_ANON_KEY = Publishable key (sb_publishable_...)
#
# NUNCA uses a Secret key (sb_secret_...) na app.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
